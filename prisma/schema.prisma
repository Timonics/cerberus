// =============================================================================
// Cerberus — Prisma data contract
// =============================================================================
//
// This file is the single source of truth for the persistence shape. Every
// bounded context reads its aggregates out of these models via repositories
// defined in `src/<context>/infrastructure/persistence/`. Repositories MUST NOT
// leak Prisma types into the domain layer — they map at the boundary.
//
// Conventions used throughout:
//
//   * Primary keys are UUIDs (`@default(uuid())`) — opaque across services and
//     safe to log at the application boundary.
//
//   * `createdAt` / `updatedAt` on every aggregate root. We do not soft-delete
//     by default; deletion is a real concern of the Engagement context's GDPR
//     tooling (V2). `User.deletedAt` exists for forward compatibility.
//
//   * Indexes are named explicitly where the lookup path matters — login,
//     token rotation, JWKS lookup by kid. Implicit indexes on `@unique` are
//     generated by Prisma and do not need to be redeclared.
//
//   * Enum names are PascalCase in Prisma, snake_case in the database column.
//     This is purely cosmetic but keeps raw SQL readable.
//
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Identity & access — bounded context: Identity
// -----------------------------------------------------------------------------

/// Top-level tenant. A user always belongs to one organization (V1: single-org
/// per user; V2 may add many-to-many via a join table without breaking this
/// schema — the `Membership` model is already a join-shaped aggregate).
model Organization {
  id        String   @id @default(uuid())
  slug      String   @unique /// URL-safe identifier (e.g. "acme-corp").
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  users           User[]
  domains         OrganizationDomain[]
  invitations     Invitation[]

  @@map("organizations")
}

/// Maps an email domain (e.g. "acme.com") to an Organization. During
/// registration, the auth service extracts the domain from the user's
/// email and looks up the corresponding Organization. If a match is
/// found, the user joins that org automatically — no slug required.
///
/// A domain may map to at most one Organization. An Organization may own
/// multiple domains (e.g. "acme.com" and "acme.co.uk" both pointing to
/// the same org).
///
/// Personal-email domains (gmail.com, yahoo.com, hotmail.com, etc.) are
/// NOT registered here — those users get an auto-generated personal org.
model OrganizationDomain {
  id             String   @id @default(uuid())
  organizationId String
  /// Lowercased email domain (e.g. "acme.com"). The registration
  /// flow lowercases the domain before lookup.
  domain         String   @unique
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_domains")
}

/// One-time invite token issued by an org admin for a specific email
/// address. Redeeming the token either creates a new user (if the email
/// has never registered) or attaches the existing user to the org
/// (V2 — multiple memberships). V1: only first-time registration is
/// supported via invite redemption.
model Invitation {
  id             String   @id @default(uuid())
  organizationId String
  /// Lowercased email address the invite is bound to. A token issued for
  /// alice@acme.com can only be redeemed by alice@acme.com.
  email          String
  /// Opaque, single-use token. Stored as a SHA-256 hash; the plaintext
  /// is returned to the inviter exactly once.
  tokenHash      String   @unique
  /// The role the invitee will hold once they redeem. Defaults to MEMBER.
  role           Role     @default(MEMBER)
  /// Optional: who issued the invite. Null if the admin was a system bot.
  invitedByUserId String?
  expiresAt      DateTime
  consumedAt     DateTime?
  /// The user that consumed the invite (set on redemption for audit).
  consumedByUserId String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

/// The membership aggregate carries the user's role inside the organization.
/// V1 ships with one role per membership; V2 may upgrade to a set.
model Membership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// A user has exactly one membership per organization. Enforced at the
  /// application layer (we don't model a `user_organization_unique` constraint
  /// here because V1 already disallows duplicates by use-case logic, but the
  /// shape allows adding it later without a migration that breaks consumers).
  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// Account credentials for password-based authentication. We store the argon2id
/// hash, never the plaintext. `passwordChangedAt` lets us invalidate refresh
/// tokens issued before a password change without scanning the session table.
model Credential {
  id                String    @id @default(uuid())
  userId            String    @unique
  passwordHash      String
  passwordChangedAt DateTime  @default(now())
  /// Set when the account is locked (e.g. after brute-force detection). The
  /// lockout window is enforced by the Authentication context against Redis.
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

/// TOTP secret for multi-factor authentication. The secret is base32-encoded
/// and stored encrypted-at-rest in production deployments (envelope encryption
/// is a V2 concern; V1 stores it as plaintext inside the database relying on
/// disk-level encryption + restricted DB access).
model MfaSecret {
  id            String         @id @default(uuid())
  userId        String         @unique
  /// base32-encoded TOTP shared secret.
  secret        String
  /// Whether the user has confirmed a working authenticator (TOTP code check
  /// on enrollment). Until confirmed, the secret is treated as pending.
  confirmed     Boolean        @default(false)
  /// Set of scratch codes used for recovery. Each is stored as an argon2id
  /// hash so we never see the plaintext in production logs.
  recoveryCodes RecoveryCode[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_secrets")
}

/// One-time recovery codes issued when MFA is enabled. Each row is hashed —
/// the plaintext is returned to the user exactly once at enrollment and never
/// persisted.
model RecoveryCode {
  id          String    @id @default(uuid())
  mfaSecretId String
  codeHash    String
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  mfaSecret MfaSecret @relation(fields: [mfaSecretId], references: [id], onDelete: Cascade)

  @@index([mfaSecretId])
  @@map("recovery_codes")
}

/// The user aggregate root. Email is the canonical identifier for login.
/// `emailVerifiedAt` is null until the engagement flow confirms the address.
model User {
  id              String    @id @default(uuid())
  organizationId  String
  email           String    @unique
  emailVerifiedAt DateTime?
  /// Display name; optional, may be null until the user sets it.
  displayName     String?
  /// Soft-delete marker; reserved for V2 GDPR tooling.
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  credential   Credential?
  mfaSecret    MfaSecret?
  memberships  Membership[]
  sessions     Session[]

  @@index([organizationId])
  @@map("users")
}

// -----------------------------------------------------------------------------
// Authentication — bounded context: Authentication
// -----------------------------------------------------------------------------

/// A login session — one row per successful authentication on a given device.
/// Refresh tokens are stored as a SHA-256 hash of the token, never as
/// plaintext. `revokedAt` is set on logout, on password change, or on admin
/// revoke. Refresh-token families (rotation chains) are tracked via
/// `familyId`; if any token in a family is reused, the entire family is
/// revoked.
model Session {
  id           String        @id @default(uuid())
  userId       String
  /// Group of related refresh tokens — used to detect token theft.
  familyId     String
  /// SHA-256 hash of the refresh token. Plaintext is never persisted.
  refreshHash  String        @unique
  userAgent    String?
  ipAddress    String?
  /// Best-effort device label derived from user agent.
  deviceLabel  String?
  /// Organization this session is scoped to. V1 (pre-V1.5) sessions
  /// have NULL here — that legacy state is interpreted as "scoped to
  /// the user's first org" by the auth flow. Going forward every
  /// login / refresh writes this column.
  organizationId String?   @db.Uuid
  issuedAt     DateTime      @default(now())
  expiresAt    DateTime
  /// Last presentation of `refreshHash`. Distinct from rotation history:
  /// `lastUsedAt` is just the timestamp; `previousRefreshHashes` is the
  /// chain of replaced hashes (used to detect token reuse).
  lastUsedAt    DateTime?
  /// V1.5: hashes of rotated refresh tokens, kept for the reuse-detection
  /// window (~5 minutes). Empty in fresh sessions. When a presented token
  /// matches an entry here, the session family is mass-revoked — the
  /// legitimate user already has the rotated token, so a re-presentation
  /// of an old hash is theft.
  previousRefreshHashes String[] @default([])
  /// V1.5 (audit C-4): tracks whether the user has completed MFA
  /// verification for this session. False on creation when the user
  /// has MFA enabled; flipped to true by VerifySecondFactorUseCase.
  /// The OAuth password/refresh grants refuse to issue an access
  /// token until this is true — otherwise a stolen password is
  /// sufficient to mint a JWT.
  mfaVerified   Boolean      @default(false)
  revokedAt     DateTime?
  /// Reason recorded on revoke; null while the session is alive.
  revokeReason RevokeReason?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([organizationId])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// Authorization — bounded context: Authorization
// -----------------------------------------------------------------------------

/// Persistent JWT signing keys. The current key signs new tokens; previous
/// keys remain in the JWKS for verification until `expiresAt`. `kid` is the
/// key identifier exposed at `/.well-known/jwks.json`.
model SigningKey {
  id         String    @id @default(uuid())
  /// Key ID — short, URL-safe. Exposed in the JWT header and JWKS.
  kid        String    @unique
  algorithm  String /// e.g. "RS256".
  /// PEM-encoded private key (PKCS#8). The whole row is application-secret.
  privatePem String
  /// PEM-encoded public key (SPKI). Embedded in the JWKS.
  publicPem  String
  createdAt  DateTime  @default(now())
  /// When this key was rotated out of signing duty. Tokens signed before this
  /// still verify against it until `expiresAt`.
  retiredAt  DateTime?
  /// When verifications stop accepting this key. Typically `retiredAt + ttl`.
  expiresAt  DateTime?
  /// Whether this is the active signing key. There is at most one row with
  /// `isCurrent = true` at any time.
  isCurrent  Boolean   @default(false)

  @@index([isCurrent])
  @@map("signing_keys")
}

// -----------------------------------------------------------------------------
// Engagement — bounded context: Engagement
// -----------------------------------------------------------------------------

/// Single-use email verification token. Created on signup, consumed on first
/// verification click, expires after `expiresAt`.
model EmailVerification {
  id         String    @id @default(uuid())
  userId     String
  /// Opaque, single-use token. Stored hashed (SHA-256).
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("email_verifications")
}

/// Single-use password-reset token. Same shape as EmailVerification; lives in
/// its own table so audit logs can distinguish reset attempts from other
/// flows.
model PasswordReset {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

/// Append-only audit log. Records every security-relevant event: logins,
/// failed logins, password changes, MFA enrolment, admin actions.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  /// Stable, machine-readable event code (e.g. `auth.login.succeeded`).
  eventType String
  /// Free-form structured payload describing the event. Stored as JSONB so
  /// downstream consumers can query without a schema migration.
  payload   Json
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  // V1.7 audit fix #31: dedup-by-(eventType, id). The outbox relay
  // can re-publish a row if the process crashes between bus.publish
  // and the processedAt update (see #33). A DB-level unique
  // constraint makes the dedup atomic — the second insert fails
  // with a P2002 error which the audit log handler catches and
  // logs at debug.
  @@unique([eventType, id])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

/// Roles available within an organization. ADMIN can manage users in the org;
/// MEMBER is the default; OWNER is the role granted to the user who created
/// the organization (V1: every user is an OWNER of their own org on signup).
enum Role {
  OWNER
  ADMIN
  MEMBER

  @@map("role")
}

/// Why a session was revoked. Stored for audit and for the support team.
enum RevokeReason {
  USER_LOGOUT
  PASSWORD_CHANGED
  ADMIN_REVOKED
  FAMILY_COMPROMISED
  EXPIRED

  @@map("revoke_reason")
}

/// Role of an admin operator within the Administration context.
/// V1 only ships `ADMIN`. `SUPER_ADMIN` (V1.5) can rotate admin keys,
/// revoke other admins' keys, and read the full audit stream.
enum AdminRole {
  ADMIN
  SUPER_ADMIN

  @@map("admin_role")
}

/// An admin API key. Generated as a random 32-byte token, hashed via
/// argon2id, only the hash is persisted. The plaintext is returned to
///   * `notes`        — soft note for the audit trail (e.g. "ci-bot").
///
/// Admin keys are issued via `POST /admin/api-keys` on the separate
/// admin listener (port 3001 by default). They authenticate
/// `Authorization: Bearer *** headers on admin endpoints. Rate
/// limiting and per-key lastUsedAt tracking are done in the repository.
model AdminApiKey {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(80)
  /// Argon2id hash of the plaintext key. Used for cryptographic verification
  /// (the slow path; only fires after a lookup-token hit).
  keyHash      String     @db.VarChar(255)
  /// V1.5: HMAC-SHA256 of the plaintext key, used as an O(1) lookup
  /// token. Stored as hex. We never look up by `keyHash` (which would
  /// require argon2 verify on every row); we look up by `lookupToken`
  /// first, then verify the match with argon2.
  lookupToken  String     @unique @db.VarChar(64)
  role         AdminRole  @default(ADMIN)
  createdAt    DateTime   @default(now())
  createdBy    String     @db.VarChar(120)
  lastUsedAt   DateTime?
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Soft note for the audit trail — e.g. "on-call laptop" or "ci-bot".
  notes        String?    @db.VarChar(255)

  @@index([keyHash])
  @@index([revokedAt])
  @@index([expiresAt])
  @@index([lookupToken])
  @@map("admin_api_keys")
}

/// A registered third-party application that integrates with Cerberus.
///
/// Apps identify themselves via `X-Cerberus-App-Id` + `X-Cerberous-App-Secret`
/// headers on register/login/etc. When a register call carries a valid
/// app credential, the new user is auto-bound to `defaultOrgSlug`
/// instead of falling through to email-domain matching or auto-creating
/// a personal org.
///
/// Apps are issued an initial `AppApiKey` at registration time;
/// plaintext is returned ONCE. Operators rotate via
/// `POST /v1/apps/:id/rotate-key`.
model App {
  id             String     @id @default(uuid()) @db.Uuid
  name           String     @db.VarChar(80)
  description    String?    @db.VarChar(500)
  /// Slug of the Organization that users registered through this
  /// app will be auto-bound to. NULL means "no auto-binding" — the
  /// register call falls through to email-domain / personal-org
  /// resolution.
  defaultOrgSlug String?    @db.VarChar(80)
  /// V1.6 (Cerberus client_credentials grant): comma-separated
  /// allowlist of OAuth2 scopes the app may request via the
  /// client_credentials grant. Empty string = no scopes
  /// (the app can authenticate via /v1/oauth/token but cannot
  /// do anything). Operator populates this at registration or
  /// via the admin API; the client_credentials use case
  /// downgrades caller-requested scope to this list (RFC 6749
  /// §3.3). Max 1024 chars — supports ~100 typical scopes.
  allowedScopes String     @default("") @db.VarChar(1024)
  createdAt      DateTime   @default(now())
  /// Contact email for the registering developer (used in audit
  /// trail — never shared with users).
  contactEmail   String     @db.VarChar(255)
  revokedAt      DateTime?
  notes          String?    @db.VarChar(500)

  /// Back-relation to `AppApiKey` rows owned by this app.
  apiKeys AppApiKey[]

  @@index([defaultOrgSlug])
  @@index([revokedAt])
  @@map("apps")
}

/// An API key for a registered App. Same shape as AdminApiKey but
/// bound to an `App` rather than to an admin operator.
///
/// Issued at app registration and rotated via
/// `POST /v1/apps/:id/rotate-key`.
model AppApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  appId      String    @db.Uuid
  keyHash    String    @db.VarChar(255)
  name       String    @db.VarChar(80)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@index([keyHash])
  @@index([revokedAt])
  @@map("app_api_keys")
}

/// V1.5: Outbox pattern. Domain events get INSERTed into this table
/// inside the same DB transaction as the aggregate change. A relay
/// process polls for unprocessed rows and publishes them through
/// the in-process EventBus. This closes the failure window where
/// a process crash between commit and in-memory publish would drop
/// the event (and the user would never get the email).
///
/// Lifecycle:
///   1. Use-case writes the aggregate row(s).
///   2. Use-case writes the Outbox row(s) in the same tx.
///   3. Use-case commits.
///   4. Relay (`OutboxRelay`) sees the unprocessed row, publishes
///      through EventBus, marks processedAt = now().
///   5. Subscribers (MailSenderDispatcher, EngagementAuditLogHandler)
///      consume the event in-process.
///
/// Failure modes covered:
///   - Crash before relay runs: row stays unprocessed, picked up
///     on next poll.
///   - Crash after publish, before mark: row gets re-published.
///     Subscribers must be idempotent (mail-sender, audit-log
///     already are — see their spec for "audit failures are caught").
model OutboxEvent {
  id          String   @id @default(uuid()) @db.Uuid
  /// Dotted event name, e.g. "engagement.email_verification.requested".
  /// Same convention as the DomainEvent.eventName getter.
  eventName   String   @db.VarChar(120)
  /// The aggregate this event belongs to. Optional — used for
  /// debugging only. (e.g. "EmailVerification" / "User")
  aggregateType String? @db.VarChar(80)
  aggregateId String?  @db.Uuid
  /// Full event payload, JSON-serialized. The relay rehydrates this
  /// into the original DomainEvent class before publishing.
  payload     Json
  /// When the row was written (= the time the originating tx committed).
  createdAt   DateTime @default(now())
  /// When the relay successfully published the event. NULL = pending.
  /// Indexed for the relay's poll query.
  processedAt DateTime?
  /// How many times the relay tried to publish. Used for backoff +
  /// dead-letter detection. After N attempts the row is flagged.
  attempts    Int      @default(0)
  /// Last error message, for ops debugging. NULL until first failure.
  lastError   String?  @db.VarChar(500)

  @@index([processedAt, createdAt])
  @@index([eventName])
  @@map("outbox_events")
}
