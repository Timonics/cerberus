# =============================================================================
# Cerberus — local development environment
# =============================================================================
# Copy this file to `.env` and replace placeholder values with real ones for
# your local Postgres / Redis / SMTP. The values below assume the
# docker-compose services are running on localhost with the default credentials.
#
# Note: PostgreSQL maps to host port 5434 and Redis to host port 6384 by
# default to avoid colliding with other commonly-running dev stacks on
# 5432/6379. Adjust as needed.
# =============================================================================

NODE_ENV=development
PORT=3000
ADMIN_PORT=3001
LOG_LEVEL=info

# JWT
JWT_ISSUER=cerberus
JWT_AUDIENCE_DEFAULT=cerberus-clients
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://cerberus:cerberus@localhost:5434/cerberus

# Redis
REDIS_URL=redis://localhost:6384

# Admin API
# Generate via:  node -e "require('argon2').hash(process.argv[1]).then(console.log)" "your-key"
ADMIN_API_KEY_HASH=
ADMIN_IP_ALLOWLIST=127.0.0.1/32,::1/128

# Email (Mailpit is the dev SMTP server in docker-compose; SMTP_PORT 1026 on host)
EMAIL_TRANSPORT=log
EMAIL_FROM=Cerberus <no-reply@cerberus.local>
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SENDGRID_API_KEY=

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=60
# Per-email rate limit (separate bucket from per-IP). 0 disables.
# Default 10/min — half of the per-IP default. Tight enough to stop
# IP-rotation brute-force on a single account, loose enough that a
# legitimate user with two devices doesn't trip it.
RATE_LIMIT_PER_EMAIL_MAX=10

# V1.7: argon2id cost factors. Defaults match the pre-V1.7
# hard-coded values; prod can dial up the work factor without
# a code change. Argon2 hashes are self-describing — old hashes
# still verify even when the live process mints new ones with
# a higher cost. Targets: 250-500ms per verify on prod hardware.
# ARGON2_MEMORY_COST=65536
# ARGON2_TIME_COST=3
# ARGON2_PARALLELISM=1
# V1.5 retention cleanup cron (see src/cleanup/)
# Schedule is a standard 5-field cron expression. Set CLEANUP_SCHEDULE=''
# to disable the cron entirely. Set any *_TTL_* to 0 to keep those rows
# indefinitely (cleanup pass becomes a no-op for that table).
CLEANUP_SCHEDULE=0 * * * *
CLEANUP_EMAIL_VERIFICATION_TTL_HOURS=0
CLEANUP_PASSWORD_RESET_TTL_HOURS=0
CLEANUP_INVITATION_TTL_DAYS=30
CLEANUP_SESSION_TTL_DAYS=30
CLEANUP_APP_KEY_TTL_DAYS=90
CLEANUP_ADMIN_KEY_TTL_DAYS=90
CLEANUP_SIGNING_KEY_TTL_DAYS=7
CLEANUP_RECOVERY_CODE_TTL_DAYS=90
CLEANUP_OUTBOX_TTL_DAYS=7
