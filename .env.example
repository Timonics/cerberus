# =============================================================================
# Cerberus — local development environment
# =============================================================================
# Copy this file to `.env` and replace placeholder values with real ones for
# your local Postgres / Redis / SMTP. The values below assume the
# docker-compose services are running on localhost with the default credentials.
#
# Note: PostgreSQL maps to host port 5434 and Redis to host port 6384 by
# default to avoid colliding with other commonly-running dev stacks on
# 5432/6379. Adjust as needed.
# =============================================================================

NODE_ENV=development
PORT=3000
ADMIN_PORT=3001
LOG_LEVEL=info

# JWT
JWT_ISSUER=cerberus
JWT_AUDIENCE_DEFAULT=cerberus-clients
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://cerberus:cerberus@localhost:5434/cerberus

# Redis
REDIS_URL=redis://localhost:6384

# Admin API
# Generate via:  node -e "require('argon2').hash(process.argv[1]).then(console.log)" "your-key"
ADMIN_API_KEY_HASH=
ADMIN_IP_ALLOWLIST=127.0.0.1/32,::1/128

# Email (Mailpit is the dev SMTP server in docker-compose; SMTP_PORT 1026 on host)
EMAIL_TRANSPORT=log
EMAIL_FROM=Cerberus <no-reply@cerberus.local>
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SENDGRID_API_KEY=

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=60